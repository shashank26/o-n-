<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>PipelineArchitect.Tests</RootNamespace>
    <AssemblyName>PipelineArchitect.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Compile game data-model sources directly so tests stay Godot-independent. -->
  <ItemGroup>
    <Compile Include="..\src\Data\**\*.cs" Link="Game\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\src\Simulation\**\*.cs" Link="Game\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\src\Challenges\**\*.cs" Link="Game\Challenges\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Pure C# workspace lifecycle (no Godot refs) — safe for headless tests. -->
    <Compile Include="..\src\UI\PipelineLifecycle.cs" Link="Game\UI\PipelineLifecycle.cs" />
  </ItemGroup>

  <!-- Ship level profiles beside the test binary for loader path resolution. -->
  <ItemGroup>
    <None Include="..\levels\**\*.json" Link="levels\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
